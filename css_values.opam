opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/janestreet/css_values"
bug-reports: "https://github.com/janestreet/css_values/issues"
dev-repo: "git+https://github.com/janestreet/css_values.git"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/css_values/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.1.0"}
  "core"
  "core_kernel"
  "jsonaf"
  "of_json"
  "ppx_jane"
  "ppx_jsonaf_conv"
  "angstrom"        {>= "0.15.0"}
  "dune"            {>= "3.17.0"}
]
available: arch != "x86_32"
conflicts: [
  "oxcaml-compiler" {< "5.2.0minus39"}
]
synopsis: "Typed representations of CSS values"
description: "
Typed representations of CSS values generated from machine-readable CSS specifications.
"
